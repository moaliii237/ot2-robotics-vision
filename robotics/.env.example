# Copy to .env (or export these in your shell) before running train_rl.py with
# experiment tracking. Do NOT commit your real keys.

# ClearML (used by train_rl.py --clearml when there is no ~/clearml.conf).
# Get these from the ClearML web UI: Settings -> Workspace -> Create new credentials.
CLEARML_API_HOST=http://<clearml-host>:8008
CLEARML_WEB_HOST=http://<clearml-host>:8080
CLEARML_FILES_HOST=http://<clearml-host>:8081
CLEARML_API_ACCESS_KEY=<your-access-key>
CLEARML_API_SECRET_KEY=<your-secret-key>

# Weights & Biases (used by train_rl.py for logging). You can also pass
# --wandb_key on the CLI, or run with --wandb_offline / --no_wandb.
WANDB_API_KEY=<your-wandb-key>
